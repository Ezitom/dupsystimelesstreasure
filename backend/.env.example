# Server Configuration
PORT=5000
JWT_SECRET=dupsy_timeless_treasure_admin_secret_key_2026

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Supabase Credentials (Service Role Key for restriction & backend execution)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail SMTP Configuration
# Note: For Gmail, use an App Password generated from your Google Account (Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="Dupsy's Timeless Treasure" <no-reply@dupsystimelesstreasure.com>

# Twilio WhatsApp API Credentials
# Sign up at https://www.twilio.com and enable the WhatsApp sandbox (or a verified sender).
# TWILIO_WHATSAPP_NUMBER must use the whatsapp: prefix, e.g. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Paystack Payment Gateway Credentials
# Sign up at https://dashboard.paystack.com/ to get your Secret & Public keys.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

